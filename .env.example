# Copy to .env and set locally. Do not paste keys into chat or commit .env.
JINA_API_KEY=

# Pinecone stores Jina vectors; the one-time indexing script creates this index.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=gstrag-jina-v1

# Optional drafting. No key = retrieval/manual review still work; no Gemini calls.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GST_GENERATION=gemini
# Leave false unless the account's data-use terms and source permission allow
# sending proprietary firm excerpts. This flag does NOT verify Google billing.
GEMINI_ALLOW_FIRM_CONTENT=false

# Optional for the local API. Blank generates a key in ignored data/app/jwt.key.
# If supplied, use a random secret with at least 32 bytes; never commit it.
GST_JWT_SECRET=

# Local default. jina = local vector search; pinecone = hosted vector search.
# Both dense modes use JINA_API_KEY; pinecone also needs PINECONE_API_KEY.
GST_RETRIEVER=bm25

# Hosted notification imports: explicitly opt in, independently of query processing.
# Use a DIFFERENT random URL-safe secret from GST_JWT_SECRET. Never commit it.
GST_NOTIFICATION_SYNC_ENABLED=false
GST_NOTIFICATION_SYNC_SECRET=
GST_NOTIFICATION_SYNC_MAX_PAGES=1
GST_NOTIFICATION_SYNC_MAX_DOCUMENTS=2
GST_NOTIFICATION_SYNC_SINCE_YEAR=2025

# Local API upload parsing runs in one durable backend worker; no provider calls.
GST_UPLOAD_WORKER_ENABLED=true
